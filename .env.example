# Copia este archivo como .env.local y llena los valores.
# Los encuentras en Supabase > Project Settings > API Keys (o Data API).

# URL del proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave publicable (empieza por sb_publishable_). Es pública por diseño:
# toda la información está protegida con Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# NOTA: la app NO necesita la clave secreta (service_role / sb_secret_).
# Nunca la pongas aquí ni en Vercel.
